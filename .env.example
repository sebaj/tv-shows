# Clave de API de TMDB (The Movie Database) - https://www.themoviedb.org/settings/api
# Sin esta clave, la app funciona igual con un catálogo de demostración local.
VITE_TMDB_API_KEY=

# --- Login con Google + agenda en la nube (opcional) ---
# Crea un proyecto gratuito en https://supabase.com y copia estos valores de
# Project Settings > API. Sin ellos, la agenda se guarda solo en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Emails de Google autorizados a usar la app, separados por coma.
# Vacío = cualquier cuenta puede entrar.
# Nota: esta lista se valida en el navegador; para reforzarla también en la
# base de datos, mira el bloque opcional de supabase/schema.sql.
VITE_ALLOWED_EMAILS=
